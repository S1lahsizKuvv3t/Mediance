<Window x:Class="Mediance.AcrylicProbe.NowPlayingCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mediance.AcrylicProbe.Localization">
    <Border x:Name="Surface" CornerRadius="17" BorderThickness="0"
            Background="#FF080B10" Opacity="0" Tapped="Surface_Tapped"
            PointerEntered="Surface_PointerEntered" PointerExited="Surface_PointerExited"
            ToolTipService.ToolTip="{x:Bind local:TextCatalog.NowPlayingCapsule}">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="{x:Bind Model.PlayLabel, Mode=OneWay}" Click="Play_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind Model.PlayGlyph, Mode=OneWay}" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{x:Bind local:TextCatalog.Next}" Click="Next_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE893;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{x:Bind local:TextCatalog.Settings}" Click="Settings_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{x:Bind local:TextCatalog.Exit}" Click="Exit_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BB;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>
        <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><CompositeTransform x:Name="RootTransform" /></Grid.RenderTransform>
            <Image Source="{x:Bind Model.Artwork, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.58" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#D9070A0F" Offset="0" />
                        <GradientStop Color="#B80B0E14" Offset="0.62" />
                        <GradientStop Color="#E607090D" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Padding="4,3,14,3" ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="#24000000">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="11" Opacity="0.5" />
                        <Image Source="{x:Bind Model.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="-1">
                    <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                               LineHeight="13" LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Model.Artist, Mode=OneWay}" FontSize="8.5" Opacity="0.7"
                               LineHeight="10" LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="2" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                        Background="#26FFFFFF" BorderThickness="0" CornerRadius="9"
                        IsEnabled="{x:Bind Model.CanToggle, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Model.PlayLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Model.PlayLabel, Mode=OneWay}"
                        Click="Play_Click">
                    <FontIcon Glyph="{x:Bind Model.PlayGlyph, Mode=OneWay}" FontSize="8" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
