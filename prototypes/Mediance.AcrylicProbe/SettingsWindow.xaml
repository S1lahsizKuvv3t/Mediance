<Window x:Class="Mediance.AcrylicProbe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mediance.AcrylicProbe.Localization"
        xmlns:vm="using:Mediance.AcrylicProbe.ViewModels">
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" Opacity="0">
        <Grid x:Name="Root" Padding="18,12,18,14" RequestedTheme="Dark" RowSpacing="8" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><CompositeTransform x:Name="RootTransform" ScaleX="0.95" ScaleY="0.95" TranslateX="24" TranslateY="8" /></Grid.RenderTransform>
            <Grid.Resources>
                <DataTemplate x:Key="ToggleRow" x:DataType="vm:ToggleSetting">
                    <Grid MinHeight="43" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind Label}" />
                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <Grid x:Name="DragRegion" Background="Transparent" ToolTipService.ToolTip="{x:Bind local:TextCatalog.DragHint}">
                    <TextBlock Text="{x:Bind local:TextCatalog.Settings}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{x:Bind local:TextCatalog.Close}" Click="Close_Click">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                </Button>
            </Grid>
            <Pivot x:Name="Pages" Grid.Row="1" Margin="-12,0,-12,0">
                <PivotItem>
                    <PivotItem.Header><TextBlock Text="{x:Bind local:TextCatalog.Appearance}" FontSize="17" /></PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Padding="0,8,8,0">
                            <ItemsControl ItemsSource="{x:Bind Settings.WindowOptions}" ItemTemplate="{StaticResource ToggleRow}" />
                            <Border Height="1" Background="#22FFFFFF" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind local:TextCatalog.Theme}" FontSize="13" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Bind Settings.ThemeOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind Settings.SelectedTheme, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                <ToggleSwitch Header="{x:Bind local:TextCatalog.StartWithWindows}" OnContent="" OffContent=""
                                              IsOn="{x:Bind Settings.StartWithWindows, Mode=TwoWay}" />
                            </StackPanel>
                            <Border Height="1" Background="#22FFFFFF" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind local:TextCatalog.GlobalShortcut}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Hotkey.ShortcutText, Mode=OneWay}" FontSize="16" />
                                <Button x:Name="SelectShortcutButton" Content="{x:Bind Hotkey.SelectButtonText, Mode=OneWay}"
                                        Click="SelectShortcut_Click" HorizontalAlignment="Left"
                                        AutomationProperties.Name="{x:Bind local:TextCatalog.SelectShortcut}" />
                                <TextBlock Text="{x:Bind Hotkey.Status, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Height="1" Background="#22FFFFFF" />
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="{x:Bind local:TextCatalog.GlassStrength}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Settings.GlassValue, Mode=OneWay}" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="10" Maximum="95" Value="{x:Bind Settings.GlassIntensity, Mode=TwoWay}" StepFrequency="1" IsEnabled="{x:Bind Settings.GlassEnabled, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind local:TextCatalog.GlassStrength}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind local:TextCatalog.DensityHint}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem>
                    <PivotItem.Header><TextBlock Text="{x:Bind local:TextCatalog.Elements}" FontSize="17" /></PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Padding="0,4,8,0" ItemsSource="{x:Bind Settings.VisibilityOptions}" ItemTemplate="{StaticResource ToggleRow}" />
                    </ScrollViewer>
                </PivotItem>
                <PivotItem>
                    <PivotItem.Header><TextBlock Text="{x:Bind local:TextCatalog.Sizes}" FontSize="17" /></PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14" Padding="0,8,8,0">
                            <StackPanel><Grid><TextBlock Text="{x:Bind local:TextCatalog.WindowWidth}" FontSize="13" /><TextBlock Text="{x:Bind Settings.WidthValue, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.65" /></Grid>
                                <Slider Minimum="420" Maximum="720" StepFrequency="10" Value="{x:Bind Settings.WindowWidth, Mode=TwoWay}" AutomationProperties.Name="{x:Bind local:TextCatalog.WindowWidth}" />
                            </StackPanel>
                            <StackPanel><Grid><TextBlock Text="{x:Bind local:TextCatalog.ArtworkSize}" FontSize="13" /><TextBlock Text="{x:Bind Settings.ArtworkValue, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.65" /></Grid>
                                <Slider Minimum="48" Maximum="120" StepFrequency="4" Value="{x:Bind Settings.ArtworkSize, Mode=TwoWay}" IsEnabled="{x:Bind Settings.ShowArtwork, Mode=OneWay}" AutomationProperties.Name="{x:Bind local:TextCatalog.ArtworkSize}" />
                            </StackPanel>
                            <StackPanel><Grid><TextBlock Text="{x:Bind local:TextCatalog.TextSize}" FontSize="13" /><TextBlock Text="{x:Bind Settings.TextValue, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.65" /></Grid>
                                <Slider Minimum="80" Maximum="140" StepFrequency="5" Value="{x:Bind Settings.TextScale, Mode=TwoWay}" AutomationProperties.Name="{x:Bind local:TextCatalog.TextSize}" />
                            </StackPanel>
                            <StackPanel><Grid><TextBlock Text="{x:Bind local:TextCatalog.ControlSize}" FontSize="13" /><TextBlock Text="{x:Bind Settings.ControlValue, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.65" /></Grid>
                                <Slider Minimum="36" Maximum="72" StepFrequency="4" Value="{x:Bind Settings.ControlSize, Mode=TwoWay}" IsEnabled="{x:Bind Settings.ShowControls, Mode=OneWay}" AutomationProperties.Name="{x:Bind local:TextCatalog.ControlSize}" />
                            </StackPanel>
                            <StackPanel><Grid><TextBlock Text="{x:Bind local:TextCatalog.LyricsTiming}" FontSize="13" /><TextBlock Text="{x:Bind Settings.LyricsTimingValue, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Opacity="0.65" /></Grid>
                                <Slider Minimum="-2000" Maximum="2000" StepFrequency="100" Value="{x:Bind Settings.LyricsLeadMilliseconds, Mode=TwoWay}" AutomationProperties.Name="{x:Bind local:TextCatalog.LyricsTiming}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind local:TextCatalog.LyricsLayout}" FontSize="13" />
                                <ComboBox ItemsSource="{x:Bind Settings.LyricsLineOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind Settings.SelectedLyricsLineOption, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem>
                    <PivotItem.Header><TextBlock Text="{x:Bind local:TextCatalog.Audio}" FontSize="17" /></PivotItem.Header>
                    <StackPanel Spacing="14" Padding="0,12,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Routing.ApplicationName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind local:TextCatalog.AudioOutput}" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <ComboBox ItemsSource="{x:Bind Routing.Choices, Mode=OneWay}" DisplayMemberPath="Name"
                                  SelectedItem="{x:Bind Routing.SelectedChoice, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Routing.CanSelect, Mode=OneWay}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{x:Bind local:TextCatalog.AudioOutput}" />
                        <Grid>
                            <Button Content="{x:Bind local:TextCatalog.Refresh}" Click="RefreshAudio_Click" FontSize="12" />
                            <ProgressRing IsActive="{x:Bind Routing.IsBusy, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind Routing.Hint, Mode=OneWay}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Routing.Error, Mode=OneWay}" FontSize="11" Foreground="#FFFFCC99" TextWrapping="Wrap" />
                    </StackPanel>
                </PivotItem>
            </Pivot>
            <TextBlock Grid.Row="2" Text="{x:Bind Settings.Error, Mode=OneWay}" Foreground="#FFFFCC99" FontSize="11" TextWrapping="Wrap" />
            <Grid Grid.Row="3">
                <Button Content="{x:Bind local:TextCatalog.Reset}" Click="Reset_Click" FontSize="12" />
                <TextBlock Text="{x:Bind local:TextCatalog.AutoSave}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Opacity="0.5" />
            </Grid>
        </Grid>
    </Border>
</Window>
