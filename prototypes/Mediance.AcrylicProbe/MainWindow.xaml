<Window x:Class="Mediance.AcrylicProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mediance.AcrylicProbe.Localization">
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" Background="Transparent" PointerWheelChanged="Surface_PointerWheelChanged">
        <Grid>
            <Border x:Name="AmbientGlow" IsHitTestVisible="False" Opacity="0.2" RenderTransformOrigin="0.5,0.5"
                    Visibility="{x:Bind Settings.AmbientGlowVisibility, Mode=OneWay}">
                <Border.RenderTransform><CompositeTransform x:Name="AmbientGlowTransform" /></Border.RenderTransform>
                <Border.Background>
                    <RadialGradientBrush Center="0.2,0.15" GradientOrigin="0.2,0.15" RadiusX="0.85" RadiusY="1.15">
                        <GradientStop x:Name="AmbientColorStop" Color="#FF305274" Offset="0" />
                        <GradientStop Color="#00305274" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Grid x:Name="Root" Margin="16,12,16,10" VerticalAlignment="Top" RequestedTheme="Dark"
                  RenderTransformOrigin="0.5,0.5" SizeChanged="Root_SizeChanged">
            <Grid.RenderTransform><CompositeTransform x:Name="RootTransform" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Canvas.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0"
                    Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                    Visibility="{x:Bind Settings.CloseVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:TextCatalog.Close}" ToolTipService.ToolTip="{x:Bind local:TextCatalog.Close}" Click="Close_Click">
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
            <Grid x:Name="TrackPanel" Grid.Row="0" Margin="0,0,30,12" ColumnSpacing="12" RenderTransformOrigin="0.5,0.5"
                  Visibility="{x:Bind Settings.MainRowVisibility, Mode=OneWay}">
                <Grid.RenderTransform><CompositeTransform x:Name="TrackPanelTransform" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtworkColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ArtworkCard" Width="{x:Bind Settings.ArtworkSize, Mode=OneWay}" Height="{x:Bind Settings.ArtworkSize, Mode=OneWay}"
                        CornerRadius="12" Background="#22FFFFFF" RenderTransformOrigin="0.5,0.5"
                        Visibility="{x:Bind Settings.ArtworkVisibility, Mode=OneWay}">
                    <Border.RenderTransform><CompositeTransform x:Name="ArtworkTransform" /></Border.RenderTransform>
                    <Grid><FontIcon Glyph="&#xE8D6;" FontSize="26" Opacity="0.4" /><Image Source="{x:Bind Model.Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" Visibility="{x:Bind Settings.MetadataVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Settings.BrandVisibility, Mode=OneWay}">
                        <Image Source="Assets/Mediance-mark.png" Width="12" Height="12" Stretch="Uniform" Opacity="0.72" />
                        <TextBlock Text="{x:Bind local:TextCatalog.AppName}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Model.Source, Mode=OneWay}" FontSize="{x:Bind Settings.SourceFontSize, Mode=OneWay}" Foreground="#FFB4C6D7" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Settings.SourceVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" FontSize="{x:Bind Settings.TitleFontSize, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Settings.TitleVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.Artist, Mode=OneWay}" FontSize="{x:Bind Settings.ArtistFontSize, Mode=OneWay}" Opacity="0.65" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Settings.ArtistVisibility, Mode=OneWay}" />
                </StackPanel>
                <StackPanel x:Name="TransportControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Visibility="{x:Bind Settings.ControlsVisibility, Mode=OneWay}">
                <Button Width="{x:Bind Settings.ControlSize, Mode=OneWay}" Height="{x:Bind Settings.ControlSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind Settings.PreviousVisibility, Mode=OneWay}" IsEnabled="{x:Bind Model.CanPrevious, Mode=OneWay}" Click="Previous_Click"
                        AutomationProperties.Name="{x:Bind local:TextCatalog.Previous}" ToolTipService.ToolTip="{x:Bind local:TextCatalog.Previous}">
                    <FontIcon Glyph="&#xE892;" FontSize="{x:Bind Settings.TransportIconSize, Mode=OneWay}" />
                </Button>
                <Button Width="{x:Bind Settings.ControlSize, Mode=OneWay}" Height="{x:Bind Settings.ControlSize, Mode=OneWay}" CornerRadius="{x:Bind Settings.PlayCornerRadius, Mode=OneWay}"
                        Padding="0" Background="#FFF0F3F6" Foreground="#FF18202B" Visibility="{x:Bind Settings.PlayVisibility, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.CanToggle, Mode=OneWay}" Click="Play_Click"
                        AutomationProperties.Name="{x:Bind Model.PlayLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.PlayLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind Model.PlayGlyph, Mode=OneWay}" FontSize="{x:Bind Settings.TransportIconSize, Mode=OneWay}" />
                </Button>
                <Button Width="{x:Bind Settings.ControlSize, Mode=OneWay}" Height="{x:Bind Settings.ControlSize, Mode=OneWay}" Padding="0" Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind Settings.NextVisibility, Mode=OneWay}" IsEnabled="{x:Bind Model.CanNext, Mode=OneWay}" Click="Next_Click"
                        AutomationProperties.Name="{x:Bind local:TextCatalog.Next}" ToolTipService.ToolTip="{x:Bind local:TextCatalog.Next}">
                    <FontIcon Glyph="&#xE893;" FontSize="{x:Bind Settings.TransportIconSize, Mode=OneWay}" />
                </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="ProgressHost" Grid.Row="1" Visibility="{x:Bind Settings.ProgressVisibility, Mode=OneWay}">
                <Grid Margin="0,0,0,8" ColumnSpacing="7" Visibility="{x:Bind Model.ProgressVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Model.PositionText, Mode=OneWay}" FontSize="10" Opacity="0.62" VerticalAlignment="Center" />
                    <Grid x:Name="SeekTrack" Grid.Column="1" Height="12" Background="Transparent" Tag="NoDrag"
                          SizeChanged="SeekTrack_SizeChanged"
                          PointerEntered="SeekTrack_PointerEntered" PointerExited="SeekTrack_PointerExited"
                          PointerPressed="SeekTrack_PointerPressed" PointerMoved="SeekTrack_PointerMoved"
                          PointerReleased="SeekTrack_PointerReleased" PointerCanceled="SeekTrack_PointerCanceled"
                          PointerCaptureLost="SeekTrack_PointerCaptureLost"
                          AutomationProperties.Name="{x:Bind local:TextCatalog.PlaybackProgress}"
                          AutomationProperties.HelpText="{x:Bind Model.ProgressLabel, Mode=OneWay}">
                        <Border x:Name="ProgressRail" Height="3" CornerRadius="3" VerticalAlignment="Center" Background="#28FFFFFF">
                            <Border x:Name="ProgressFill" CornerRadius="3" HorizontalAlignment="Stretch" Background="#DDF3F7FB" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind Model.DurationText, Mode=OneWay}" FontSize="10" Opacity="0.62" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <StackPanel x:Name="AudioOutputPanel" Grid.Row="2" Margin="0,0,0,4" Spacing="4" Visibility="{x:Bind Settings.AudioOutputVisibility, Mode=OneWay}">
                <Grid>
                    <TextBlock Text="{x:Bind local:TextCatalog.AudioOutput}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    <ProgressRing IsActive="{x:Bind Routing.IsBusy, Mode=OneWay}" Width="16" Height="16" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{x:Bind Routing.Choices, Mode=OneWay}" DisplayMemberPath="Name"
                              SelectedItem="{x:Bind Routing.SelectedChoice, Mode=TwoWay}"
                              IsEnabled="{x:Bind Routing.CanSelect, Mode=OneWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{x:Bind local:TextCatalog.AudioOutput}" />
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="RefreshAudio_Click" AutomationProperties.Name="{x:Bind local:TextCatalog.Refresh}"
                            ToolTipService.ToolTip="{x:Bind local:TextCatalog.Refresh}">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock Text="{x:Bind Routing.Error, Mode=OneWay}" FontSize="11" Foreground="#FFFFCC99" TextWrapping="Wrap"
                           Visibility="{x:Bind Routing.ErrorVisibility, Mode=OneWay}" />
            </StackPanel>
            <Border x:Name="LyricsPanel" Grid.Row="3" Margin="0,0,0,12" Background="#0CFFFFFF" CornerRadius="12" Padding="16,14"
                    RenderTransformOrigin="0.5,0"
                    Visibility="{x:Bind Lyrics.PanelVisibility, Mode=OneWay}" PointerWheelChanged="LyricsPanel_PointerWheelChanged">
                <Border.RenderTransform><CompositeTransform x:Name="LyricsPanelTransform" /></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Bind Lyrics.Status, Mode=OneWay}" FontSize="12" Opacity="0.65"
                               TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind Lyrics.MessageVisibility, Mode=OneWay}" />
                    <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="7"
                                Visibility="{x:Bind Lyrics.AuthorVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Lyrics.AuthorPreviousLine, Mode=OneWay}" Height="28" MaxLines="1"
                                   FontSize="11" Opacity="0.35" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Lyrics.AuthorCurrentLine, Mode=OneWay}" MinHeight="42" MaxLines="2"
                                   FontSize="16" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Lyrics.AuthorNextLine, Mode=OneWay}" Height="28" MaxLines="1"
                                   FontSize="11" Opacity="0.45" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Lyrics.AuthorProgress, Mode=OneWay}" HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.55" />
                        <Button Content="{x:Bind Lyrics.AuthorButtonLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                                MinHeight="42" IsEnabled="{x:Bind Lyrics.AuthorButtonEnabled, Mode=OneWay}"
                                Click="LyricsSync_Click" AutomationProperties.Name="{x:Bind Lyrics.AuthorButtonLabel, Mode=OneWay}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Space" Invoked="LyricsSyncSpace_Invoked" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind Lyrics.AuthoringControlsVisibility, Mode=OneWay}">
                            <Button Content="{x:Bind local:TextCatalog.LyricsManualRestart}" Padding="12,5" Click="LyricsSyncRestart_Click" />
                            <Button Content="{x:Bind local:TextCatalog.LyricsManualCancel}" Padding="12,5" Click="LyricsSyncCancel_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Visibility="{x:Bind Lyrics.SyncedVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="OutgoingLyricsLines" Grid.Row="0" Spacing="9" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel.RenderTransform><TranslateTransform x:Name="OutgoingLyricsTranslate" /></StackPanel.RenderTransform>
                            <TextBlock x:Name="OutgoingPreviousLine" Height="32" MaxLines="2" FontSize="12" Opacity="0.38" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind Settings.PreviousLyricVisibility, Mode=OneWay}" />
                            <TextBlock x:Name="OutgoingCurrentLine" Height="48" MaxLines="2" FontSize="17" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="OutgoingNextLine" Height="32" MaxLines="2" FontSize="12" Opacity="0.5" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="SyncedLyricsLines" Grid.Row="0" Spacing="9">
                            <StackPanel.RenderTransform><TranslateTransform x:Name="SyncedLyricsTranslate" /></StackPanel.RenderTransform>
                            <Button x:Name="PreviousLyricButton" Height="32" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="PreviousLyric_Click"
                                    Visibility="{x:Bind Settings.PreviousLyricVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Lyrics.PreviousLine, Mode=OneWay}" MaxLines="2" FontSize="12" Opacity="0.38" TextAlignment="Left" HorizontalAlignment="Stretch" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Height="48" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="CurrentLyric_Click">
                                <TextBlock Text="{x:Bind Lyrics.CurrentLine, Mode=OneWay}" MaxLines="2" FontSize="17" FontWeight="SemiBold" TextAlignment="Left" HorizontalAlignment="Stretch" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Height="32" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Click="NextLyric_Click">
                                <TextBlock Text="{x:Bind Lyrics.NextLine, Mode=OneWay}" MaxLines="2" FontSize="12" Opacity="0.5" TextAlignment="Left" HorizontalAlignment="Stretch" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Content="{x:Bind local:TextCatalog.LyricsManualRedo}"
                                HorizontalAlignment="Right" Margin="0,7,0,0" Padding="8,3" FontSize="10"
                                Background="Transparent" BorderThickness="0" Click="LyricsSyncRedo_Click"
                                Visibility="{x:Bind Lyrics.RetimingVisibility, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
            <Grid x:Name="Footer" Grid.Row="4" ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ToggleButton x:Name="LockToggle" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                              IsChecked="{x:Bind Settings.IsLocked, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind Settings.LockLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Settings.LockLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind Settings.LockGlyph, Mode=OneWay}" FontSize="11" />
                </ToggleButton>
                <ToggleButton x:Name="TopmostToggle" Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                              IsChecked="{x:Bind Settings.AlwaysOnTop, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind local:TextCatalog.Topmost}" ToolTipService.ToolTip="{x:Bind local:TextCatalog.Topmost}">
                    <FontIcon Glyph="&#xE718;" FontSize="11" />
                </ToggleButton>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" FontSize="10" Opacity="0.55" Visibility="{x:Bind Settings.StatusVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" FontSize="11" Foreground="#FFFFCC99" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="3" Content="{x:Bind Lyrics.ToggleLabel, Mode=OneWay}" FontSize="11" Foreground="#FF9C9EA5"
                        Background="Transparent" BorderThickness="0" Padding="6,2" MinHeight="22" Click="Lyrics_Click"
                        Visibility="{x:Bind Settings.LyricsButtonVisibility, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Lyrics.ToggleLabel, Mode=OneWay}" />
                <Button x:Name="SettingsButton" Grid.Column="4" Content="{x:Bind local:TextCatalog.Settings}" FontSize="11" Foreground="#FF9C9EA5"
                        Background="Transparent" BorderThickness="0" Padding="6,2" MinHeight="22" Click="Settings_Click"
                        AutomationProperties.Name="{x:Bind local:TextCatalog.Settings}" />
            </Grid>
            </Grid>
            <Border x:Name="VolumeHud" Canvas.ZIndex="30" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                    Margin="0,10,0,0" Padding="12,6" CornerRadius="10" Background="#E020252C"
                    BorderBrush="#24FFFFFF" BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.RenderTransform><CompositeTransform x:Name="VolumeHudTransform" /></Border.RenderTransform>
                <TextBlock x:Name="VolumeHudText" FontSize="13" FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Border>
</Window>
